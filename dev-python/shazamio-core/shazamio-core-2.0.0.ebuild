inherit cargo distutils-r1 pypi

DESCRIPTION="Rust core for the shazamio Shazam API client."
HOMEPAGE="https://github.com/shazamio/shazamio-core
	https://pypi.org/project/shazamio-core/"
SRC_URI+=" ${CARGO_CRATE_URIS}"

