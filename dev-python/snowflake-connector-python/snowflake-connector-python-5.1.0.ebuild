inherit cargo distutils-r1 pypi

DESCRIPTION="Snowflake database connector for Python"
HOMEPAGE="https://pypi.org/project/snowflake-connector-python/"

SRC_URI+=" ${CARGO_CRATE_URIS}"

LICENSE="Apache-2.0"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD CC0-1.0 CDDL
	CDLA-Permissive-2.0 ISC MIT MPL-2.0 openssl Unicode-3.0 ZLIB BZIP2
"
SLOT="0"
KEYWORDS="~amd64"
IUSE="debug pandas"

RDEPEND="
	>=dev-python/cryptography-46.0.5[${PYTHON_USEDEP}]
	>=dev-python/protobuf-6.32.1[${PYTHON_USEDEP}]
	<dev-python/protobuf-7[${PYTHON_USEDEP}]
	dev-python/pytz[${PYTHON_USEDEP}]
	>=dev-python/tomlkit-0.13[${PYTHON_USEDEP}]
	pandas? (
		>=dev-python/pandas-2.1.2[${PYTHON_USEDEP}]
		<dev-python/pandas-3[${PYTHON_USEDEP}]
		>=dev-python/pyarrow-14.0.1[${PYTHON_USEDEP}]
	)
"
BDEPEND="
	dev-libs/protobuf
	>=dev-python/cython-3.1[${PYTHON_USEDEP}]
	dev-python/setuptools[${PYTHON_USEDEP}]
"

python_prepare_all() {
	# Protobuf modules are already generated in the sdist.
	sed -i 's/, "mypy-protobuf~=5.0"//' pyproject.toml || die
	distutils-r1_python_prepare_all
}

python_compile() {
	# The sdist ships generated protobuf modules; avoid rebuilding type stubs.
	export SKIP_PROTO_GENERATION=true
	export PROTOC="${BROOT}/usr/bin/protoc"
	export CORE_CARGO_TARGET_DIR
	CORE_CARGO_TARGET_DIR="$(cargo_target_dir)"
	filter-lto
	tc-export AR CC CXX PKG_CONFIG
	local triple
	triple="$(rust_abi)" || die
	triple=${triple//-/_}
	local -x RUSTFLAGS
	RUSTFLAGS="$(cargo_env printenv "CARGO_TARGET_${triple^^}_RUSTFLAGS")" || die
	distutils-r1_python_compile
}
