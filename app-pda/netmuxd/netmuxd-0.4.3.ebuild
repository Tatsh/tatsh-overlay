LICENSE="MIT"
# Dependent crate licenses
LICENSE+=" Apache-2.0 BSD ISC MIT MPL-2.0 openssl Unicode-3.0"
SLOT="0"
KEYWORDS="~amd64"

src_prepare() {
	# cargo_src_install passes --frozen when GIT_CRATES is set, so the lock has
	# to already reflect nusb coming from the patched path rather than git.
	cp "${FILESDIR}/${P}-Cargo.lock" Cargo.lock || die
	default
}

src_install() {
	cargo_src_install
	systemd_dounit "${FILESDIR}/${PN}.service"
	einstalldocs
}
