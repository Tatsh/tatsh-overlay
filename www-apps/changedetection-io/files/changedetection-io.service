[Unit]
Description=Website change detection and monitoring service
After=network-online.target
Wants=network-online.target

[Service]
User=changedetection
Group=changedetection
Environment=LISTEN_HOST=127.0.0.1 PORT=5000
ExecStart=/usr/bin/changedetection.io -d /var/lib/changedetection
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=changedetection
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
