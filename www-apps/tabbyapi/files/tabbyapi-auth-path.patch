Store the generated API tokens under /var/lib/tabbyapi instead of the current
working directory, which is not writable for the service user.

Upstream now routes both the read and the write through the module-level
AUTH_FILE constant, so pointing that at the state directory is enough.

--- a/tabbyapi/common/auth.py
+++ b/tabbyapi/common/auth.py
@@ -18,7 +18,7 @@
 from tabbyapi.common.logger import xlogger
 from tabbyapi.common.utils import coalesce

-AUTH_FILE = "api_tokens.yml"
+AUTH_FILE = "/var/lib/tabbyapi/api_tokens.yml"

 # Seconds between checks for changes to the auth file
 AUTH_FILE_POLL_INTERVAL = 2.0
