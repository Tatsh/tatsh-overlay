Upstream deliberately does not install the project ("py-modules = []") because
it is run from a checkout. We do install it, so turn on package discovery.

Use setuptools' automatic discovery rather than an explicit package list: the
set of backends changes between snapshots (exllamav2 was dropped in favour of
exllamav3), and a hardcoded list breaks the build every time that happens.

--- a/pyproject.toml
+++ b/pyproject.toml
@@ -6,9 +6,8 @@
 ]
 build-backend = "setuptools.build_meta"

-# We're not building the project itself
-[tool.setuptools]
-py-modules = []
+[tool.setuptools.packages.find]
+include = ["tabbyapi*"]

 [project]
 name = "tabbyAPI"
