Mount the per-user VFS by absolute path.

The launcher installed by the ebuild copies the read-only system VFS into
$HOME/.local/share/PumpkinOS on first run. Referring to it absolutely means the
emulator works regardless of the working directory it is started from.

--- a/script/pumpkin.lua
+++ b/script/pumpkin.lua
@@ -53,7 +53,7 @@
   fullrefresh = true
 end
 
-pit.mount("./vfs/", "/")
+pit.mount(os.getenv('HOME') .. '/.local/share/PumpkinOS/vfs/', "/")
 
 pumpkin = pit.loadlib("libos")
 pumpkin.init()
