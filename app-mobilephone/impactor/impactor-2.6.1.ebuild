inherit cargo desktop xdg

DESCRIPTION="Open-source, cross-platform, and feature rich iOS sideloading application."
HOMEPAGE="https://github.com/claration/Impactor"
SRC_URI="https://github.com/claration/Impactor/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}"
S="${WORKDIR}/Impactor-${PV}"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	AGPL-3 Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD
	Boost-1.0 BlueOak-1.0.0 CC0-1.0 CDLA-Permissive-2.0 ISC MIT MPL-2.0
	Unicode-3.0 ZLIB BZIP2
"
SLOT="0"
KEYWORDS="~amd64"

DEPEND="
	dev-libs/openssl:=
	x11-libs/gtk+:3
	x11-libs/libxkbcommon
"
RDEPEND="
	${DEPEND}
	app-pda/usbmuxd
	dev-libs/libayatana-appindicator
	media-libs/vulkan-loader
"
BDEPEND="virtual/pkgconfig"

src_compile() {
	cargo_src_compile --workspace --bins
}

src_install() {
	local dir
	dir="$(cargo_target_dir)"
	newbin "${dir}"/plumeimpactor impactor
	dobin "${dir}"/plumesign

	local id="dev.khcrysalis.PlumeImpactor"
	sed -i "s/^Exec=plumeimpactor$/Exec=impactor/" "package/linux/${id}.desktop" || die
	domenu "package/linux/${id}.desktop"

	local size
	for size in 16 32 48 64 128 256 512; do
		doicon -s "${size}" "package/linux/icons/hicolor/${size}x${size}/apps/${id}.png"
	done

	einstalldocs
}
