inherit cargo

MY_PN="ProcDump-Linux"

DESCRIPTION="Linux port of the Sysinternals ProcDump tool"
HOMEPAGE="https://github.com/microsoft/ProcDump-Linux"
SRC_URI="https://github.com/microsoft/${MY_PN}/archive/refs/tags/${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}"
S="${WORKDIR}/${MY_PN}-${PV}"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+=" BSD-2 BSD MIT Unicode-3.0"
SLOT="0"
KEYWORDS="~amd64"

RDEPEND="dev-libs/elfutils
	virtual/zlib:="
DEPEND="${RDEPEND}"
# clang compiles the eBPF program.
BDEPEND="llvm-core/clang
	virtual/pkgconfig"

src_prepare() {
	default
	# Newer Clang turns the eBPF program's byte-zeroing loop into a memset() call, which BPF
	# cannot link.
	sed -e 's/^\(\s*\)"-Wno-unknown-warning-option".into(),$/&\n\1"-fno-builtin-memset".into(),/' \
		-i crates/procdump/build.rs || die
	grep -q 'fno-builtin-memset' crates/procdump/build.rs || die "failed to patch build.rs"
}

src_compile() {
	# The embedded .NET profiler uses MSVC extensions that only Clang accepts; upstream's build
	# script falls back to clang++ when CXX is unset.
	local -x CXX="${CHOST}-clang++"
	cargo_src_compile --package procdump-cli --bin procdump
}

src_install() {
	dobin "$(cargo_target_dir)/procdump"
	doman procdump.1
	einstalldocs
}
