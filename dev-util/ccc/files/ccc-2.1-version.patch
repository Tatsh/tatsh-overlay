From: Andrew Udvare <audvare@gmail.com>
Subject: [PATCH] Stamp the release version when building outside a git checkout

version_finder.cmake reads the version from the git tag. A release tarball
carries no git metadata, so every tool reports itself as a development build.

diff --git a/cmake/version_finder.cmake b/cmake/version_finder.cmake
index 40c21ec..c34c07c 100644
--- a/cmake/version_finder.cmake
+++ b/cmake/version_finder.cmake
@@ -13,7 +13,7 @@ if(GIT_FOUND AND EXISTS "${CMAKE_SOURCE_DIR}/.git")
 	)
 else()
 	message(WARNING "Cannot find git")
-	set(GIT_TAG "")
+	set(GIT_TAG "v2.1")
 endif()
 
 add_library(ccc_versioninfo STATIC
