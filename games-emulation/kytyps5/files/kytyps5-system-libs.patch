+#ifndef KYTY_COMMON_USER_DATA_DIR_H_
+#define KYTY_COMMON_USER_DATA_DIR_H_
+
+#include <cstdlib>
+#include <filesystem>
+#include <system_error>
+
+namespace Common {
+
+// Settings, saves, patches and logs are written relative to the working
+// directory. A system install is read-only, so work from
+// $XDG_DATA_HOME/kytyps5 (default ~/.local/share/kytyps5) instead.
+inline bool EnterUserDataDirectory() {
+	std::filesystem::path dir;
+	if (const char* xdg = std::getenv("XDG_DATA_HOME"); xdg != nullptr && *xdg == '/') {
+		dir = xdg;
+	} else if (const char* home = std::getenv("HOME"); home != nullptr && *home != '\0') {
+		dir = std::filesystem::path(home) / ".local" / "share";
+	} else {
+		return false;
+	}
+	dir /= "kytyps5";
+	std::error_code ec;
+	std::filesystem::create_directories(dir, ec);
+	std::filesystem::current_path(dir, ec);
+	return !ec;
+}
+
+} // namespace Common
+
+#endif /* KYTY_COMMON_USER_DATA_DIR_H_ */
