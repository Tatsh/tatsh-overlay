diff --git a/src/SharpEmu.GUI/Updater.cs b/src/SharpEmu.GUI/Updater.cs
index 0cb7006..e365928 100644
--- a/src/SharpEmu.GUI/Updater.cs
+++ b/src/SharpEmu.GUI/Updater.cs
@@ -25,6 +25,12 @@ public static class Updater
 
     public static async Task<UpdateInfo?> CheckAsync(string? currentSha, CancellationToken cancellationToken = default)
     {
+        // Updates are handled by the system package manager.
+        if (OperatingSystem.IsLinux())
+        {
+            return null;
+        }
+
         var platform = CurrentPlatform();
         using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
         timeout.CancelAfter(CheckTimeout);
