+++ b/src/main.cpp
@@ -13,6 +13,42 @@
 #include "core/user_settings.h"
 #include "qt_gui/game_install_dialog.h"
 #include "qt_gui/main_window.h"
+#ifdef SHADPS4_SYSTEM_VERSION
+#include <algorithm>
+#include <QDate>
+#include <QStandardPaths>
+#include "qt_gui/gui_settings.h"
+
+// Register the emulator installed in PATH as a version and select it by default.
+static void RegisterSystemEmulator() {
+    const QString exe = QStandardPaths::findExecutable(QStringLiteral("shadps4"));
+    if (exe.isEmpty()) {
+        return;
+    }
+    const std::string path = exe.toStdString();
+    const std::string name = "v" SHADPS4_SYSTEM_VERSION;
+    auto versions = VersionManager::GetVersionList();
+    auto it = std::find_if(versions.begin(), versions.end(),
+                           [&](const VersionManager::Version& v) { return v.path == path; });
+    if (it == versions.end() || (it->codename == "Local" && it->name != name)) {
+        if (it != versions.end()) {
+            VersionManager::RemoveVersion(*it);
+        }
+        VersionManager::AddNewVersion({
+            .name = name,
+            .path = path,
+            .date = QDate::currentDate().toString(Qt::ISODate).toStdString(),
+            .codename = "Local",
+            .type = VersionManager::VersionType::Custom,
+            .id = 0,
+        });
+    }
+    gui_settings settings{};
+    if (settings.GetValue(gui::vm_versionSelected).toString().isEmpty()) {
+        settings.SetValue(gui::vm_versionSelected, exe);
+    }
+}
+#endif
 #ifdef _WIN32
 #include <windows.h>
 #endif
