declare -A GIT_CRATES=(
	[libfreemkv]='https://github.com/freemkv/libfreemkv;4686f7f90561ce301c1b0f91fad93d0b0fb2b966;libfreemkv-%commit%'
	[mediatek-optical]='https://github.com/MattJackson/mediatek-optical;21031df434cff7fb2a4efbaa54a824b245933a95;mediatek-optical-%commit%'
	[pioneer-optical]='https://github.com/MattJackson/pioneer-optical;241b614773ec5c044e3af73601f486387be19a24;pioneer-optical-%commit%'
	[thumb-asm]='https://github.com/MattJackson/thumb-asm;0d9b37aa76c964949256146ce9be0cfbe4f823a0;thumb-asm-%commit%'
)

RUST_MIN_VER="1.94.0"

inherit cargo desktop xdg

DESCRIPTION="Optical drive firmware backup and flasher for freemkv"
HOMEPAGE="https://github.com/freemkv/freemkv-firmware"
SRC_URI="https://github.com/freemkv/${PN}/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}"

LICENSE="MIT"
# Dependent crate licenses
LICENSE+="
	0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD-2 BSD Boost-1.0
	CC0-1.0 CDLA-Permissive-2.0 ISC MIT OFL-1.1 UbuntuFontLicense-1.0
	Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
IUSE="gui"

DEPEND="gui? (
		dev-libs/glib:2
		gui-libs/gtk:4
		gui-libs/libadwaita:1
	)"
# eframe loads its windowing and GL libraries at runtime.
RDEPEND="${DEPEND}
	gui? (
		dev-libs/wayland
		media-libs/libglvnd
		x11-libs/libX11
		x11-libs/libxkbcommon
	)"
BDEPEND="gui? ( virtual/pkgconfig )"

src_prepare() {
	# Leave stripping and LTO to the user's flags and Portage.
	sed -i '/^\[profile.release\]/,/^$/{/^strip\|^lto\|^codegen-units/d}' Cargo.toml || die
	default
}

src_compile() {
	local pkg pkgs=( freemkv-flash freemkv-fw )
	use gui && pkgs+=( freemkv-flash-gui freemkv-fw-gui )
	cargo_src_compile "${pkgs[@]/#/--package=}"
}

src_install() {
	local bin
	for bin in freemkv-crossflash freemkv-flash freemkv-fw; do
		dobin "$(cargo_target_dir)/${bin}"
	done
	if use gui; then
		for bin in freemkv-flash-gui freemkv-fw-gui; do
			dobin "$(cargo_target_dir)/${bin}"
			domenu "packaging/linux/org.freemkv.${bin}.desktop"
			newicon "crates/${bin}/assets/freemkv.png" "org.freemkv.${bin}.png"
		done
	fi
	einstalldocs
	dodoc crates/freemkv-flash/README.md
}
